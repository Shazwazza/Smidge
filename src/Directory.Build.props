<Project>

  <!-- Import the repo-root props (TreatWarningsAsErrors, etc.) since the nearest-only auto-import stops here -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- These are Source link props -->
    <PublishRepositoryUrl>https://github.com/Shazwazza/Smidge</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All"/>
  </ItemGroup>
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Shazwazza/Smidge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shazwazza/Smidge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>$(Copyright)</Copyright>
    <Company>Shannon Deminick</Company>
    <Authors>shandem</Authors>
    <PackageIcon>logo-nuget.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>5.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>ci</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
